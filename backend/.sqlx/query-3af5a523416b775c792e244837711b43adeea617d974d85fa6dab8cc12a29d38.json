  "query": "\n            UPDATE tasks\n            SET status = $2::varchar,\n                completed_at = CASE WHEN $2::varchar = 'done' THEN NOW() ELSE completed_at END\n            WHERE id = $1\n            RETURNING id, booking_id, assigned_to, title, description, due_at,\n                status, created_by, created_at, completed_at\n            ",
