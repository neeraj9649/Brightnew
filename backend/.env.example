# Local development: copy to backend/.env (never commit the real one).
DATABASE_URL=postgresql://localhost:5432/brightwings
JWT_SECRET=change-me-long-random
REFRESH_TOKEN_SECRET=change-me-long-random
PASSWORD_HASH_SECRET=change-me-long-random
PORT=9010
# The portal calls this API from the browser, so credentialed CORS must be on.
ENABLE_APP_CORS=true
# Exact comma-separated origins for local development and the deployed portal.
CORS_ALLOWED_ORIGIN=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001,https://portal.brightwingstravel.com
# Local only: returns the PIN-reset code in the response instead of sending it. Never in production.
OTP_DEV_ECHO=true
# Refresh cookie (defaults: Lax + non-Secure in debug builds, Secure + SameSite=None + Partitioned in release).
# COOKIE_SECURE=false
# COOKIE_SAMESITE=lax
