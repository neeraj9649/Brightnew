# Local development: copy to backend/.env (never commit the real one).
DATABASE_URL=postgresql://localhost:5432/brightwings
JWT_SECRET=change-me-long-random
REFRESH_TOKEN_SECRET=change-me-long-random
PASSWORD_HASH_SECRET=change-me-long-random
PORT=9010
# The portal calls this API from the browser, so credentialed CORS must be on.
ENABLE_APP_CORS=true
# Exact comma-separated origins for local development and the deployed portal.
CORS_ALLOWED_ORIGIN=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001,https://portal.brightwingstravel.com
# Local only: returns the PIN-reset code in the response instead of sending it. Never in production.
OTP_DEV_ECHO=true
# Refresh cookie (defaults: Lax + non-Secure in debug builds, Secure + SameSite=None + Partitioned in release).
# COOKIE_SECURE=false
# COOKIE_SAMESITE=lax
# Access-token lifetime in minutes (default 1440 = 1 day); the refresh cookie lasts REFRESH_TOKEN_EXP_DAYS (default 30).
# JWT_TOKEN_EXP_MINUTES=1440
# Join / Forgot-passcode codes. WhatsApp first (Messages API template), then SMS via Twilio Verify
# (Verify Service code length must be 6). Without these, codes go by e-mail only (or OTP_DEV_ECHO locally).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# WhatsApp sender and template default to Bright Wings' own; WHATSAPP_OTP_FROM=off disables WhatsApp.
# WHATSAPP_OTP_FROM=+919252153290
# WHATSAPP_OTP_CONTENT_SID=HX611fe1a9d4dae2ff54ef7bfddaec21db
# Website contact form (POST /public/enquiries): sent from this Hostinger mailbox to ENQUIRY_TO_EMAIL.
# Separate from SMTP_* so member codes/invites can use a different sender.
ENQUIRY_SMTP_HOST=smtp.hostinger.com
ENQUIRY_SMTP_PORT=465
ENQUIRY_SMTP_USERNAME=ajay.kumar@brightwingstravel.in
ENQUIRY_SMTP_PASSWORD=
ENQUIRY_TO_EMAIL=info@brightwingstravel.in
