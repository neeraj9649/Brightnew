# /etc/bright-wings/bp.env  (chmod 600, owned by root; never commit real values)
DATABASE_URL=postgresql://brightwings:CHANGE_ME@127.0.0.1:5432/brightwings
ADDRESS=127.0.0.1
PORT=9010
CORS_ALLOWED_ORIGIN=https://portal.brightwingstravel.com
JWT_SECRET=CHANGE_ME_LONG_RANDOM
REFRESH_TOKEN_SECRET=CHANGE_ME_LONG_RANDOM
PASSWORD_HASH_SECRET=CHANGE_ME_LONG_RANDOM
REFRESH_TOKEN_COOKIE_NAME=refresh_token
REFRESH_TOKEN_EXP_DAYS=30
JWT_TOKEN_EXP_MINUTES=15
PHP_UPLOADER_BASE_URL=https://resource.brightwingstravel.in
PHP_UPLOADER_TOKEN=CHANGE_ME
PORTAL_URL=https://portal.brightwingstravel.com
SUPPORT_PHONE=
# PIN-reset delivery: configure at least one of the two
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
# NEVER set OTP_DEV_ECHO in production
