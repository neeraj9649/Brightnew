# /etc/bright-wings/bp.env  (chmod 600, owned by root; never commit real values)
DATABASE_URL=postgresql://brightwings:CHANGE_ME@127.0.0.1:5432/brightwings
ADDRESS=127.0.0.1
PORT=9010
# Exact comma-separated origins allowed to use the credentialed API.
CORS_ALLOWED_ORIGIN=https://portal.brightwingstravel.com,https://brightwingstravel.com,https://www.brightwingstravel.com,https://brightwingstravel.in,https://www.brightwingstravel.in,http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
ENABLE_APP_CORS=true
JWT_SECRET=CHANGE_ME_LONG_RANDOM
REFRESH_TOKEN_SECRET=CHANGE_ME_LONG_RANDOM
PASSWORD_HASH_SECRET=CHANGE_ME_LONG_RANDOM
REFRESH_TOKEN_COOKIE_NAME=refresh_token
REFRESH_TOKEN_EXP_DAYS=30
JWT_TOKEN_EXP_MINUTES=1440
# Refresh cookie. Portal (portal.brightwingstravel.com) and API (bp.nsiif.in) are different
# sites, so the cookie must be Secure + SameSite=None (+ Partitioned for browsers that block
# third-party cookies). If the API moves to a subdomain of the portal's site (e.g.
# api.brightwingstravel.com) use COOKIE_SAMESITE=lax, COOKIE_PARTITIONED=false and
# COOKIE_DOMAIN=.brightwingstravel.com instead -- that also works in Safari.
COOKIE_SECURE=true
COOKIE_SAMESITE=none
COOKIE_PARTITIONED=true
# COOKIE_DOMAIN=
PHP_UPLOADER_BASE_URL=https://resources.brightwingstravel.com
# Optional override; BASE_URL is still needed for file retrieval URLs
# PHP_UPLOADER_UPLOAD_URL=https://resources.brightwingstravel.com/upload.php
PHP_UPLOADER_TOKEN=CHANGE_ME
PORTAL_URL=https://portal.brightwingstravel.com
SUPPORT_PHONE=
# Comma-separated phones promoted to super_admin at startup (account must already be registered)
SUPER_ADMIN_PHONES=9649863232
# PIN-reset delivery: configure at least one of the two
# Join / Forgot-passcode codes: WhatsApp first, then SMS via Twilio Verify (code length 6, set in the Twilio Console).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# Optional: WhatsApp sender/template override (defaults are built in); WHATSAPP_OTP_FROM=off disables WhatsApp.
# WHATSAPP_OTP_FROM=+919252153290
# WHATSAPP_OTP_CONTENT_SID=HX611fe1a9d4dae2ff54ef7bfddaec21db
# Approved WhatsApp content template for tour enquiries to the office.
WHATSAPP_TOUR_ENQUIRY_CONTENT_SID=
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
# Website contact form (POST /public/enquiries): sends to info@brightwingstravel.com from this Hostinger mailbox.
# Separate from SMTP_* so member codes/invites can use a different sender.
ENQUIRY_SMTP_HOST=smtp.hostinger.com
ENQUIRY_SMTP_PORT=465
ENQUIRY_SMTP_USERNAME=ajay.kumar@brightwingstravel.in
ENQUIRY_SMTP_PASSWORD=
# Recipient override for other enquiry sources.
ENQUIRY_TO_EMAIL=info@brightwingstravel.in
# Tour page "Book This Tour" requests (default info@brightwingstravel.com), sent with ENQUIRY_SMTP_*.
BOOKING_TO_EMAIL=info@brightwingstravel.com
# NEVER set OTP_DEV_ECHO in production
